/dts-v1/;
#include <nordic/nrf52832_qfaa.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "BLE door sensor";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,uart-mcumgr = &uart0;
		zephyr,bt-mon-uart = &uart0;
		zephyr,bt-c2h-uart = &uart0;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		led0 = &led0;
		sw0 = &button;
		ambient-temp0 = &shtc3;
		ambient-light0 = &light_sensor;
		watchdog0 = &wdt0;
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
			label = "User LED";
		};
	};

	buttons {
		compatible = "gpio-keys";
		hall_sensor: hall_sensor {
			gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
			label = "Hall sensor";
			zephyr,code = <INPUT_KEY_0>;
		};
		button: button0 {
			gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
			label = "User Button";
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	light_sensor: ambient_light_sensor {
		compatible = "phototransistor-special";
		enable-gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
		io-channels = <&adc 4>;
		pulldown-ohm = <1000>;
	};

	zephyr,user {
		io-channels = <&adc 1>;
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";

	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	shtc3: shtc3@70 {
		status = "okay";
		compatible = "sensirion,shtc3", "sensirion,shtcx";
		reg = <0x70>;
		// may also be measure-mode = "low-power";
		measure-mode = "normal";
		clock-stretching;
	};
};


&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_VDD>;
		zephyr,resolution = <12>;
	};

	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; /* 10us */
		zephyr,input-positive = <NRF_SAADC_AIN4>; /* P0.28 */
		zephyr,oversampling = <3>; /* x8 */
		zephyr,resolution = <12>;
	};
};

&uicr {
	gpio-as-nreset;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&uart0 {
	compatible = "nordic,nrf-uarte";
	current-speed = <115200>;
	status = "okay";
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&flash0 {

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			// 24kByte
			reg = <0x00000000 0x06000>;
		};
		slot0_partition: partition@6000 {
			label = "image-0";
			// 232kByte
			reg = <0x00006000 0x3A000>;
		};
		slot1_partition: partition@40000 {
			label = "image-1";
			// 232kByte
			reg = <0x00040000 0x3A000>;
		};
		scratch_partition: partition@7a000 {
			label = "image-scratch";
			// 20kByte
			reg = <0x0007A000 0x05000>;
		};
		storage_partition: partition@7f000 {
			label = "storage";
			// 4kByte
			reg = <0x0007F000 0x00001000>;
		};
	};
};


&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 20)>,
				<NRF_PSEL(UART_RX, 0, 19)>;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 20)>,
				<NRF_PSEL(UART_RX, 0, 19)>;
			low-power-enable;
		};
	};

	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 7)>,
				<NRF_PSEL(TWIM_SCL, 0, 6)>;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 7)>,
				<NRF_PSEL(TWIM_SCL, 0, 6)>;
			low-power-enable;
		};
	};
};
